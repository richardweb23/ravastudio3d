{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ravastudio3d",
  "keep_vars": true,
  "vars": { "RIVOXEL_SITE_ENABLED": "true" },
  "compatibility_date": "2026-11-19",
  "main": "./workers/entrada.ts",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "previews": {}
}
