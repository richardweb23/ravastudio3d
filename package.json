{
  "name": "rava-studio-3d-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "node --test src/lib/*.test.js",
    "check": "npm run test && npm run test:db && npm run lint && npm run build",
    "test:db": "node --test tests/*-db.test.mjs",
    "dev:local": "vite --mode localtest --host 127.0.0.1 --port 5173 --strictPort",
    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:status": "supabase status",
    "db:local:reset": "supabase db reset --local"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "^9.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "supabase": "2.117.0",
    "vite": "^6.2.1"
  }
}
